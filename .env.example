NEXT_PUBLIC_SITE_URL=https://valleys-darley.vercel.app
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Random secret at least 32 characters; server-only
AUTH_SECRET=
# Independent admin login; store these only as Vercel Environment Variables.
ADMIN_USERNAME=
# Format: scrypt:<hex salt>:<hex hash>. Generate with: node scripts/generate-admin-credentials.mjs
ADMIN_PASSWORD_HASH=
# Random secret, at least 32 characters, separate from AUTH_SECRET.
ADMIN_SESSION_SECRET=
# Full HTTPS admin origin after domain registration and Vercel setup
ADMIN_ORIGIN=
# Created automatically when Vercel Blob is connected to this project.
BLOB_READ_WRITE_TOKEN=
# Stripe server-side key (sk_test_... during testing, sk_live_... only after validation).
STRIPE_SECRET_KEY=
# Signing secret for the endpoint /api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Fixed Thailand shipping fee in whole baht; set 0 explicitly for free shipping.
STRIPE_SHIPPING_FEE_THB=
# Generate in the Thailand Post Track & Trace developer account; server-only.
THAILAND_POST_TOKEN_KEY=
